    "@types/passport": "^0",
    "@types/passport-jwt": "^4",
    "@types/pg": "^8",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "globals": "^16.0.0",
    "oxlint": "^1.58.0",
